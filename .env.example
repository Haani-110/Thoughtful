# Thoughtful environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# All variables are SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.

# OpenRouter (AI ranking)
OPENROUTER_API_KEY=

# eBay (client credentials — Browse API for live listings)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay Marketplace Account Deletion — verification token
EBAY_MARKETPLACE_VERIFICATION_TOKEN=
